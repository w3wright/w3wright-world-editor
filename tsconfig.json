{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "preserve",
    "lib": ["ES2020", "DOM"],
    "useDefineForClassFields": true,
    "module": "ESNext",

    /* Bundler mode */
    "moduleResolution": "bundler",

    /* The ~ alias, kept in step with resolve.alias in vite.config.ts */
    "paths": { "~/*": ["./src/*"] },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "pages/**/*.vue",
    // Generated by `vue-router/vite`. Listed so `vue-router/auto-routes` and the
    // generated `RouteNamedMap` resolve; it is gitignored, so a fresh clone has no
    // types until a build or the dev server has run once.
    ".auto-generate/**/*.d.ts"
  ]
}
